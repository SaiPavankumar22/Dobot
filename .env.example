# ============================================================================
# Dobot environment — copy to `.env` and fill in what you need.
#
# How to read this file:
#   REQUIRED      → the app cannot do its main job without it
#   (empty value) → Dobot runs WITHOUT it, degraded on purpose (see docs/prerequisites.md)
#
# Rule of thumb: set NEBIUS_API_KEY and you have a working assistant.
#                add TAVILY_API_KEY and it can also research the web.
#                everything below that is optional tuning.
# ============================================================================

# --- REQUIRED: reasoning (Nebius Token Factory / NVIDIA Nemotron) ------------
NEBIUS_API_KEY=
# OpenAI-compatible endpoint. Legacy api.studio.nebius.com 404s — leave this default.
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEMOTRON_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
NEMOTRON_SUPER_MODEL=nvidia/nemotron-3-super-120b-a12b
NEMOTRON_LIGHT_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEMOTRON_VISION_MODEL=openbmb/MiniCPM-V-4_5
# Optional local OpenAI-compatible provider (for example Ollama or llama.cpp).
# Set REASONING_PROVIDER=local and LOCAL_MODEL to an installed model; the server is never started
# by Dobot. Use hybrid only when you have intentionally configured the local endpoint.
REASONING_PROVIDER=cloud
LOCAL_MODEL_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_MODEL=
# Thinking traces = better planning but slower answers. Off by default; deep planning re-enables
# it per request. Set to 1 to always think.
NEMOTRON_ALWAYS_THINK=false

# --- REQUIRED for web research (Tavily) --------------------------------------
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com

# --- Local memory ------------------------------------------------------------
# Structured records and semantic memory stay on this device.
# Semantic memory runs on Dobot's own local vector index (persisted under .dobot/),
# so there is no hosted vector database to configure.
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B

# --- Agent harness (LangGraph) ------------------------------------------------
# Every tool step runs through a validate→execute→finalise loop. With langgraph installed the loop
# is a real state graph; without it the same stages run inline. Outcomes are identical either way.
LANGGRAPH_ENABLED=true
# false = drive the request lifecycle (see→understand→decide→act) without the graph runtime.
ORCHESTRATION_ENGINE_LANGGRAPH=true

# --- Deep research (deepagents harness) -------------------------------------------------
# 1 = the planner may run a deepagents research subagent (multi-search, cited report). Needs
# NEBIUS_API_KEY + TAVILY_API_KEY. Read-only, still gated by the decision engine.
DEEPAGENTS_ENABLED=false

# --- Usage monitoring (LangSmith) ----------------------------------------------
# Optional hosted tracing of every model call and harness stage (tokens, latency, errors).
# Leave the key empty and this is completely off — no network calls, no cost.
LANGSMITH_API_KEY=
LANGSMITH_API_URL=https://api.smith.langchain.com
LANGSMITH_PROJECT=dobot

# --- Decision layer: JEV (AutoTrust JEV-27B-VL) ---------------------------------
# JEV is Dobot's judgement layer. Its model is AutoTrust JEV-27B-VL on Novita's decision-
# evaluation endpoint: each proposed action is scored for risk (choice over low/medium/high/
# critical, thinking only when the answer is unsure), untrusted on-screen/web text is checked
# for prompt injection, and the captured screenshot is checked for visible credentials.
# Bring your own key: Settings → Your API keys → Novita, or NOVITA_API_KEY here
# (get one at https://novita.ai/settings/key-management). Only input tokens are billed.
# Without a key the Doctor says so and the deterministic policies decide alone.
JEV_ENABLED=true
JEV_MODE=advisory
NOVITA_API_KEY=
NOVITA_BASE_URL=https://api.novita.ai
JEV_MODEL=autotrust/jev-27b-vl
# off | auto | on — `auto` thinks only when the risk answer's confidence is below the threshold.
JEV_THINKING=auto
JEV_THRESHOLD=0.8
JEV_REASONING_EFFORT=medium
JEV_THINK_BUDGET=512
# 0 = skip the on-screen-credential vision check.
JEV_SCREEN_CHECK=true
SHADOW_MODE=false
# 1 = ask before anything that changes your files, even at MEDIUM risk. Reads stay automatic.
REQUIRE_WRITE_APPROVAL=false
# ask | assist | agent  (agent = safe work proceeds, risky stops for approval)
EXECUTION_MODE=agent
KILL_SWITCH_HOTKEY=Ctrl+Shift+Esc

# --- File guard -----------------------------------------------------------------
# Never read or written by any tool, approved or not. Comma-separated, ~ expanded.
PROTECTED_PATHS=~/.ssh,~/.aws,~/.gnupg,~/.kube,~/.netrc,~/.config/gh,~/.config/gcloud,~/.docker/config.json,~/.dobot.secret

# --- Skills ----------------------------------------------------------------------
# block | warn | off — skills are scanned for injection/secrets/exfiltration before the planner sees them.
SKILL_SCAN_MODE=block
SKILL_SCAN_ALLOWLIST=

# --- Agent runtime (Hermes) -------------------------------------------------------
# local    = built-in guarded tools only (no external binary, never probes anything).
# cli      = the `hermes` CLI.
# remote   = the real Hermes gateway over HTTP, and — with HERMES_FALLBACK_LOCAL=true below —
#            wrapped in a resilient runtime: gateway up → desktop delegation works; gateway
#            down → Dobot serves on its own tools and says which part is blocked.
# auto     = same resilient wrapper, probing first (this is what the HF Space image runs).
# See docs/hermes.md: `hermes gateway run` with API_SERVER_ENABLED=true, then set the two
# values below. HERMES_API_KEY must equal the gateway's API_SERVER_KEY.
AGENT_RUNTIME=local
# true (default) = degrade to local tools when the gateway is unreachable.
# false          = strict "Hermes or nothing": calls fail instead of falling back.
HERMES_FALLBACK_LOCAL=true
# Seconds a health answer is trusted before re-probing; the probe itself times out fast so a
# dead gateway never delays a plan.
HERMES_HEALTH_TTL_SECONDS=30
HERMES_PROBE_TIMEOUT_SECONDS=2.5
HERMES_COMMAND=hermes
HERMES_ARGS=-p
HERMES_ENDPOINT=http://127.0.0.1:8642
HERMES_API_KEY=
# Optional: pin one Hermes session id so successive Dobot turns share a conversation.
HERMES_SESSION_ID=
HERMES_ALLOWED_TOOLS=browser_exec,computer_use,terminal,filesystem,skills
HERMES_TIMEOUT_SECONDS=300

# --- Security boundary (NemoClaw / OpenShell / Nebius sandboxes) ------------------
# local    = Dobot's action firewall only (paths/hosts/timeouts, NO kernel isolation).
# nemoclaw = route execution through the NemoClaw CLI / OpenShell gateway.
# nebius   = run terminal commands inside a Nebius Sandboxes (ConTree beta) VM:
#            VM-level isolation + a persistent, versioned session per agent, with no
#            local daemon at all. Needs NEBIUS_API_KEY (top of file) + NEBIUS_PROJECT_ID.
SANDBOX_PROVIDER=local
NEMOCLAW_COMMAND=nemoclaw
NEMOCLAW_SANDBOX=dobot
OPENSHIELD_GATEWAY_URL=
# --- Nebius sandbox (only used when SANDBOX_PROVIDER=nebius) ----------------------
NEBIUS_PROJECT_ID=
NEBIUS_SANDBOX_BASE_URL=https://api.tokenfactory.nebius.com/sandboxes/
NEBIUS_SANDBOX_IMAGE=python:3.12-slim
SANDBOX_ALLOWED_NETWORK=tavily.com,api.tavily.com,api.studio.nebius.com,github.com,arxiv.org
SANDBOX_ALLOWED_PATHS=~/,~/Documents,~/Downloads,~/Projects

# --- Context compression (TokenJuice) -------------------------------------------------
# Tool output is compressed before reaching the model; the full text is still stored and shown.
TOKENJUICE_ENABLED=true
TOKENJUICE_MIN_CHARS=1200
TOKENJUICE_MAX_CHARS=4000
TOKENJUICE_HEAD_LINES=40
TOKENJUICE_TAIL_LINES=25

# --- Cost ledger ------------------------------------------------------------------------
# USD per million tokens. 0 = token counts recorded, cost shown as UNKNOWN (no guessed prices).
PRICE_PER_MTOK_INPUT=0
PRICE_PER_MTOK_OUTPUT=0
RUN_JOURNAL_LIMIT=200
RUN_JOURNAL_KEEP=200

# --- Memory maintenance -------------------------------------------------------------------
MEMORY_DECAY_ENABLED=true
MEMORY_HALF_LIFE_DAYS=21
MEMORY_FORGET_THRESHOLD=0.12
CONSOLIDATION_ENABLED=true
CONSOLIDATION_INTERVAL_SECONDS=21600
CANONICAL_FACTS_LIMIT=40
CANONICAL_PROMOTE_AFTER=3

# --- Identity --------------------------------------------------------------------------------
PRINCIPAL_NAME=
ASSISTANT_NAME=Dobot

# --- Pre-action interceptors --------------------------------------------------------------------
# Your ```dobot-rules in GENOME.md compiled into hard pre-execution checks. Can only tighten.
INTERCEPTORS_ENABLED=true

# --- Voice: speak (OS engine) + listen (CrisperWhisper) -----------------------------------------
# Speak: OS speech engine — no dependency, no network, no key. Off by default.
VOICE_ENABLED=false
VOICE_NAME=
VOICE_RATE=0
VOICE_MAX_CHARS=1200
# Listen: local mic transcription (Whisper via faster-whisper, runs in this process, audio never
# leaves the machine). Needs: cd backend && uv sync --all-extras (plus ffmpeg on PATH for webm/ogg
# recordings; add the voice-gpu extra on an NVIDIA laptop). Without the package the mic button
# explains why instead of pretending.
TRANSCRIBER_ENABLED=true
# CTranslate2 checkpoint. Default: OpenAI Whisper small (244M params, MIT, ~484 MB on disk,
# ~250 MB RAM at int8) — quick to download and easy on a laptop. CrisperWhisper variants
# (verbatim with [UM]/[UH]) work too, but only as CT2 builds: `nyralabs/faster_CrisperWhisper`
# (~3 GB) or a self-converted CrisperWhisper2.0_* (pip install "crisperwhisper[convert]"). The
# raw nyralabs/CrisperWhisper2.0_* repos are transformers safetensors and will NOT load.
TRANSCRIBER_MODEL=Systran/faster-whisper-small
# auto = prefer CUDA, fall back to CPU if the card cannot load or run the checkpoint. An explicit
# cuda / cpu is honoured literally. TRANSCRIBER_COMPUTE_TYPE: auto = int8_float16 on GPU, int8 on CPU.
TRANSCRIBER_DEVICE=auto
TRANSCRIBER_COMPUTE_TYPE=auto
# Threads for CPU inference. 0 = every logical core (faster-whisper would use 4).
TRANSCRIBER_CPU_THREADS=0

# --- Voice agent: the live call (chat from the dot menu → Voice) ----------------------------------
# The speech-to-speech cascade runs inside the backend and streams every stage:
#   mic → Silero VAD → local Whisper → streaming Nemotron → Sarvam TTS → the panel's speaker.
# Talking over it cancels the reply in flight (barge-in), the way a phone call does.
VOICE_CALL_ENABLED=true
# TTS — Sarvam AI (bulbul models). Create a key at https://console.sarvam.ai (new accounts get
# ₹100 of credits); it is read only by this process and never sent to a window.
SARVAM_API_KEY=
SARVAM_TTS_BASE_URL=https://api.sarvam.ai
SARVAM_TTS_MODEL=bulbul:v4-flash
# Empty = the model's default persona. Pick another id from the Sarvam voices page if you like.
SARVAM_TTS_VOICE=
SARVAM_TTS_LANGUAGE=en-IN
SARVAM_TTS_SAMPLE_RATE=24000
# LLM for the call — defaults to your reasoning stack (the NVIDIA Nemotron models above), so a
# working NEBIUS_API_KEY is enough to make the call talk. To use NVIDIA's own endpoint instead:
#   VOICE_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
#   VOICE_LLM_API_KEY=<key from https://build.nvidia.com/settings/api-keys>
#   VOICE_LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
VOICE_LLM_BASE_URL=
VOICE_LLM_API_KEY=
VOICE_LLM_MODEL=
# Turn detection for the call — the defaults suit most rooms. Raise the threshold if the call
# starts speaking too early; raise the silence window if it cuts you off mid-sentence.
VOICE_VAD_THRESHOLD=0.5
VOICE_VAD_SILENCE_MS=550
VOICE_VAD_PAD_MS=160

# --- Local API auth ----------------------------------------------------------------------------------
# Empty = open on loopback (fine for a personal laptop). Set a token to require Bearer auth.
# Generate one:  cd backend && uv run python -m app.selftest --new-token
DOBOT_API_TOKEN=

# --- Multi-user (opt-in) ------------------------------------------------------------------------------
# false = the classic single-user Dobot: no accounts, one shared store, DOBOT_API_TOKEN is the only gate.
# true  = accounts: per-user memory/tasks/automations/API keys, invite-gated registration, per-user
#         event streams. The first registered account is the owner; it can mint invite codes.
MULTI_USER=false
# true lets anyone register without an invite (the first account is always the owner regardless).
MULTI_USER_OPEN_REGISTRATION=false

# --- Screen / OCR --------------------------------------------------------------------------------------
SCREEN_CAPTURE=on_demand
OCR_ENABLED=true
OCR_LANGUAGE=eng

# --- Runtime ------------------------------------------------------------------
DOBOT_ENV=development
LOG_LEVEL=INFO
DOBOT_HOST=127.0.0.1
DOBOT_PORT=8756
DOBOT_STATE_DIR=.dobot
# Empty = the repo's own skills/ folder. Point elsewhere to keep your skills out of the checkout.
DOBOT_SKILLS_DIR=
AUTOMATION_POLL_SECONDS=30
